# Copier vers .env.local et adapter. Aucune de ces variables n'est obligatoire en développement.

# URL publique finale du site (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test des phases : force la date « maintenant » (ISO 8601 avec fuseau). Ne pas définir en production.
# NEXT_PUBLIC_FORCE_NOW=2026-11-20T10:00:00+01:00

# SMTP (e-mail de confirmation). Sans ces variables, l'e-mail est simplement journalisé en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Concours M-MAIN1 <no-reply@example.org>"
# Copie interne de chaque candidature (optionnel)
SUBMISSIONS_NOTIFY_EMAIL=

# Dossier de stockage des candidatures (défaut : ./storage/submissions)
# SUBMISSIONS_DIR=

# Plafond de candidatures par IP et par fen�tre de 10 min (d�faut : 5)
# RATE_LIMIT_MAX=5
